# ============================================================
# CodeVault Environment Variables Template
# Copy this file to .env and fill in your credentials
# ============================================================

# LeetCode Credentials (REQUIRED)
# Get from browser cookies after logging into LeetCode
# LEETCODE_SESSION is the main authentication cookie (~800 chars)
# LEETCODE_CSRF_TOKEN is the CSRF protection token (~32 chars)
LEETCODE_SESSION=your_leetcode_session_cookie_here
LEETCODE_CSRF_TOKEN=your_csrftoken_cookie_here

# GitHub Token (REQUIRED)
# Generate at: Settings → Developer settings → Personal access tokens
# Required scopes: repo, workflow
PAT_TOKEN=your_github_pat_token_here

# Email Notifications (REQUIRED for notifications)
# Uses Gmail App Password (NOT your regular Gmail password)
# Generate at: Google Account → Security → App Passwords
# Password should be exactly 16 characters with NO spaces
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password_here
EMAIL_RECIPIENT=recipient_email@gmail.com

# SMTP Settings (Optional - defaults to Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587